# Copy this file to .env and fill in your Supabase project values.
# Find these in your Supabase dashboard: Project Settings -> API
#
# NOTE: Vite only exposes variables prefixed with VITE_ to the browser.
# The anon key is safe to expose in the client — protect data with
# Supabase Row Level Security (RLS) policies, not by hiding this key.
#
# IMPORTANT: Auth is owned by KSP Hub — this MUST be the same Supabase
# project Hub uses ("KSP Online": same URL, same anon key), not a separate
# one, or the shared .ksponline.co.uk session cookie won't resolve to a
# real session here.

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key
